{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.quantum-l9.dev/ci/consumer/v1",
	"title": "L9 CI consumer metadata",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "l9.ci-consumer/v1" },
		"owner": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
		},
		"repo_class": {
			"type": "string",
			"enum": ["auto", "python", "typescript"],
			"default": "auto"
		},
		"waiver_refs": {
			"type": "array",
			"maxItems": 32,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"product_kind": {
			"type": "string",
			"enum": ["node", "dependency"],
			"description": "Declared Quantum-L9/.github ProductKind (l9.product-kinds/global@1). `node` marks a Constellation node behind Constellation.Gate; only nodes receive the Gate routing rules as blocking."
		}
	},
	"required": ["schema"]
}
