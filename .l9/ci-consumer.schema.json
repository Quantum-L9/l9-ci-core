{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quantum-l9.dev/ci/consumer/v1",
  "title": "L9 CI consumer metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "l9.ci-consumer/v1"},
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repo_class": {
      "type": "string",
      "enum": ["auto", "python", "typescript"],
      "default": "auto"
    },
    "waiver_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": ["schema"]
}
