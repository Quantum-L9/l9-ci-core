{
  "schema": "l9.core-repository-policy/v1",
  "comparison_ref": "origin/main",
  "clean_paths": [
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache"
  ],
  "automation": {
    "lock": {
      "name": "l9-repo.lock",
      "stale_after_seconds": 1800
    }
  },
  "change_policy": {
    "gate_order": [
      "workflow",
      "actions",
      "sdk-compatibility",
      "repository-execution"
    ],
    "gates": {
      "workflow": {
        "match_any_prefix": [
          ".github/workflows/"
        ],
        "blocking": true,
        "commands": [
          [
            "@python",
            "-m",
            "unittest",
            "discover",
            "--start-directory",
            "tests/workflows",
            "--pattern",
            "test_*.py",
            "--verbose"
          ]
        ]
      },
      "actions": {
        "match_any_prefix": [
          ".github/actions/"
        ],
        "blocking": true,
        "commands": [
          [
            "@python",
            "-m",
            "unittest",
            "discover",
            "--start-directory",
            "tests/architecture",
            "--pattern",
            "test_*.py",
            "--verbose"
          ]
        ]
      },
      "sdk-compatibility": {
        "match_any_prefix": [
          ".l9/sdk-compatibility.yaml"
        ],
        "blocking": true,
        "commands": [
          [
            "@python",
            "-m",
            "unittest",
            "discover",
            "--start-directory",
            "tests/provisioning",
            "--pattern",
            "test_*.py",
            "--verbose"
          ],
          [
            "@python",
            "-m",
            "unittest",
            "discover",
            "--start-directory",
            "tests/workflows",
            "--pattern",
            "test_phase_3_workflows.py",
            "--verbose"
          ]
        ]
      },
      "repository-execution": {
        "match_any_prefix": [
          "tools/l9_repo/",
          "tests/repo_execution/",
          ".l9/repo-workflow.json",
          ".l9/core-repo-policy.json",
          "Makefile",
          "Repo.mk"
        ],
        "blocking": true,
        "commands": [
          [
            "@python",
            "-m",
            "unittest",
            "discover",
            "--start-directory",
            "tests/repo_execution",
            "--pattern",
            "test_*.py",
            "--verbose"
          ]
        ]
      }
    },
    "companion_rules": [
      {
        "id": "manifest-integrity",
        "match_any_prefix": [
          ""
        ],
        "require_all_paths": [
          "MANIFEST.sha256"
        ],
        "message": "every tracked change requires a regenerated MANIFEST.sha256"
      },
      {
        "id": "workflow-tests",
        "match_any_prefix": [
          ".github/workflows/"
        ],
        "require_any_prefix": [
          "tests/workflows/"
        ],
        "message": "workflow changes require workflow-test coverage"
      },
      {
        "id": "action-tests",
        "match_any_prefix": [
          ".github/actions/"
        ],
        "require_any_prefix": [
          "tests/"
        ],
        "message": "composite-action changes require companion tests"
      },
      {
        "id": "sdk-pin-mirrors",
        "match_any_prefix": [
          ".l9/sdk-compatibility.yaml"
        ],
        "require_any_prefix": [
          "tests/provisioning/"
        ],
        "require_all_paths": [
          ".github/actions/provision-sdk/action.yml",
          ".github/actions/provision-sdk/provision.py",
          ".github/workflows/normalize-semgrep-report.yml",
          ".github/workflows/publish-analysis.yml",
          ".github/workflows/sdk-contract-check.yml",
          ".l9/architecture.yaml",
          ".l9/artifact-protocol.yaml",
          "MANIFEST.sha256"
        ],
        "message": "SDK compatibility changes require every documented Core pin mirror and provisioning tests"
      },
      {
        "id": "repository-execution-evidence",
        "match_any_prefix": [
          "tools/l9_repo/",
          ".l9/repo-workflow.json",
          ".l9/core-repo-policy.json",
          "Makefile",
          "Repo.mk"
        ],
        "require_any_prefix": [
          "tests/repo_execution/"
        ],
        "require_all_paths": [
          "AGENTS.md",
          "docs/repository-execution-runtime.md",
          "MANIFEST.sha256"
        ],
        "message": "repository execution changes require the repo_execution suite, agent instructions, operator documentation, and manifest refresh"
      }
    ]
  },
  "agent_contracts": {
    "required_files": [
      "AGENTS.md",
      ".l9/architecture.yaml",
      ".l9/ownership.yaml",
      ".l9/sdk-compatibility.yaml",
      ".l9/org-runtime-contract.yaml",
      ".l9/org-runtime-interface.yaml",
      ".l9/repo-workflow.json",
      ".l9/core-repo-policy.json",
      "tools/check_workflow_integrity.py"
    ],
    "reference_requirements": [
      {
        "target": ".l9/architecture.yaml",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/ownership.yaml",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/sdk-compatibility.yaml",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/org-runtime-contract.yaml",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/org-runtime-interface.yaml",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/repo-workflow.json",
        "instruction_files": [
          "AGENTS.md"
        ]
      },
      {
        "target": ".l9/core-repo-policy.json",
        "instruction_files": [
          "AGENTS.md"
        ]
      }
    ]
  },
  "reporting": {
    "agent_check_json": "artifacts/agent-check-evidence.json",
    "agent_check_markdown": "artifacts/agent-check-evidence.md",
    "capture_limit_chars": 20000
  },
  "status": {
    "fetch_remote": true
  },
  "authority": {
    "target_authorities": [
      "AGENTS.md",
      ".l9/architecture.yaml",
      ".l9/ownership.yaml",
      ".l9/sdk-compatibility.yaml",
      ".l9/org-runtime-contract.yaml",
      ".l9/org-runtime-interface.yaml"
    ],
    "derived_documents": [
      "docs/repository-execution-runtime.md"
    ],
    "generated_artifacts": [
      "Makefile"
    ],
    "dependency_manifests": [
      "requirements-ci.txt",
      "requirements-repo-runtime.txt"
    ]
  }
}
