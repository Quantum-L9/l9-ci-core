{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/make-plan/v1",
  "title": "L9 Make Capability Plan",
  "description": "Resolved, provenance-bearing compiler input. Provenance is producer-attested trace metadata: the producer or envelope authority owns evidence binding and authenticity, while this compiler validates structure and digest format and preserves provenance deterministically. Capability detection remains owned by the SDK or repository-native authority that produced this plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository_class", "provenance", "capabilities"],
  "properties": {
    "schema": {"const": "l9.make-plan/v1"},
    "repository_class": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "source", "digest"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "digest"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "kind", "provenance"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["doctor", "setup", "build", "lint", "test", "validate", "check", "package", "generate", "benchmark", "status", "clean"]
        },
        "state": {"enum": ["supported", "not_required", "unsupported"]},
        "kind": {"enum": ["native_binding", "compatibility_alias"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$"}
        },
        "diagnostic": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "supported"}}, "required": ["state"]},
          "then": {"required": ["argv"]},
          "else": {"required": ["diagnostic"]}
        }
      ]
    }
  }
}
