{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/make-capability-plan/v1",
  "title": "L9 Make Capability Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bindings"],
  "properties": {
    "schema": {"const": "l9.make-capability-plan/v1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "command"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "command": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
