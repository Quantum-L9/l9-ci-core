{
  "lock": ".github/actions/install-consumer-ci/toolchain-lock.json",
  "non_dependency_lock_keys": {
    "python": "interpreter selected by setup-python; not a package-manager dependency"
  },
  "schema": "l9.core-owned-tools/v1",
  "tools": [
    {
      "ecosystems": {
        "pip": ["bandit"],
        "pre-commit": ["https://github.com/PyCQA/bandit"],
        "uv": ["bandit"]
      },
      "name": "bandit"
    },
    {
      "ecosystems": {
        "npm": ["@biomejs/biome"]
      },
      "name": "biome"
    },
    {
      "ecosystems": {
        "pre-commit": ["https://github.com/gitleaks/gitleaks"]
      },
      "name": "gitleaks"
    },
    {
      "ecosystems": {
        "pip": ["mypy"],
        "pre-commit": ["https://github.com/pre-commit/mirrors-mypy"],
        "uv": ["mypy"]
      },
      "name": "mypy"
    },
    {
      "ecosystems": {
        "pip": ["pip"],
        "uv": ["pip"]
      },
      "name": "pip"
    },
    {
      "ecosystems": {
        "pip": ["pip-audit"],
        "pre-commit": ["https://github.com/pypa/pip-audit"],
        "uv": ["pip-audit"]
      },
      "name": "pip-audit"
    },
    {
      "ecosystems": {
        "pip": ["pre-commit"],
        "uv": ["pre-commit"]
      },
      "name": "pre-commit"
    },
    {
      "ecosystems": {
        "pip": ["pytest"],
        "uv": ["pytest"]
      },
      "name": "pytest"
    },
    {
      "ecosystems": {
        "pip": ["ruff"],
        "pre-commit": ["https://github.com/astral-sh/ruff-pre-commit"],
        "uv": ["ruff"]
      },
      "name": "ruff"
    },
    {
      "ecosystems": {
        "pip": ["semgrep"],
        "uv": ["semgrep"]
      },
      "name": "semgrep"
    },
    {
      "ecosystems": {
        "pip": ["uv"],
        "uv": ["uv"]
      },
      "name": "uv"
    }
  ]
}
